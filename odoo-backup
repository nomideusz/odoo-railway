#!/bin/bash
# Dump the database + filestore (the same zip Odoo's database manager makes) and
# upload it to the Railway bucket. Keyed by weekday: the bucket always holds the
# last 7 nightly backups. Run it by hand (railway ssh) before risky changes.
set -euo pipefail

DB=${ODOO_DB:-odoo}
f=/tmp/$DB-$(date -u +%a).zip
trap 'rm -f "$f"' EXIT

setpriv --reuid=odoo --regid=odoo --init-groups env HOME=/var/lib/odoo \
  odoo db -c /etc/odoo/odoo.conf dump "$DB" "$f"
# Railway buckets are virtual-hosted style: https://<bucket>.<endpoint host>/<key>
curl -fsS --aws-sigv4 "aws:amz:${S3_REGION:-auto}:s3" \
  -u "$S3_ACCESS_KEY_ID:$S3_SECRET_ACCESS_KEY" \
  -T "$f" "https://$S3_BUCKET.${S3_ENDPOINT#https://}/${f##*/}"
echo "odoo-backup: uploaded ${f##*/} ($(du -h "$f" | cut -f1))"
